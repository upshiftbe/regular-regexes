  "street_address": "\\b(?:(?:Calle|Avenida|Plaza|Plaça|Paseo|Passeig|Carretera|Camino|Ronda|Travesía|Carrer|Rúa)\\s|(?:C/|Avda\\.|Av\\.|Pza\\.|P\\.?º|Ctra\\.)\\s?)(?:(?:de|del|la|las|los|el)\\s|d')*[A-ZÁÉÍÓÚÑ0-9][\\w'ºª. -]{0,40}?,?\\s(?:[nN]\\.?º\\s?|núm\\.\\s?)?(?:\\d{1,4}[A-Z]?|s/n)\\b(?:,?\\s\\d{1,2}[º°](?:\\s?(?:[A-Z]|\\d{1,2}ª)\\b)?)?",
