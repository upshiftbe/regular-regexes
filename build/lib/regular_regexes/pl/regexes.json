  "street_address": "(?<![\\w.])(?<!\\d )(?<!et )(?i:ul\\.|ulica|al\\.|alej[ae]|pl\\.|plac|os\\.|osiedle)\\s?(?:[A-ZĄĆĘŁŃÓŚŹŻ0-9][\\w'-]*\\.?|[a-ząćęłńóśźż]{1,5}\\.)(?:\\s[\\w'.-]+){0,4}?\\s\\d+[A-Za-z]?(?:\\s?/\\s?\\d+[A-Za-z]?)?(?:,?\\s(?i:m\\.|lok\\.)\\s?\\d+[A-Za-z]?)?(?![\\w/])",
  "vat_number": {
    "regex": "\\bPL ?(?:\\d{10}|\\d{3}-\\d{3}-\\d{2}-\\d{2}|\\d{3}-\\d{2}-\\d{2}-\\d{3})\\b",
