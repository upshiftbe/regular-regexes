  "company_name": "(?<![\\w&'.„”\"-])[„\"]?[A-ZĄĆĘŁŃÓŚŹŻ0-9][\\w&'.„”\"-]*(?:\\s(?:[„\"]?[A-ZĄĆĘŁŃÓŚŹŻ0-9][\\w&'.„”\"-]*|&|i)){0,6}\\s(?:[Ss][Pp](?:ółka|\\.)\\s?[Zz]\\s?[Oo]\\.\\s?[Oo]\\.(?:\\s?[Ss][Pp]\\.\\s?[Kk]\\.)?|[Ss]półka (?:z ograniczoną odpowiedzialnością|akcyjna|jawna|komandytowa)|S\\.\\s?A\\.|SA|S\\.K\\.A\\.|P\\.S\\.A\\.|[Ss][Pp]\\.\\s?[JjKkPp]\\.)(?!\\w)",
