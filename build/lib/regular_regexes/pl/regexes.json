    "validator": "phone",
    "regions": "PL"
  },
  "postal_code_city": "(?<![\\w-])\\d{2}-\\d{3}\\s[A-ZĄĆĘŁŃÓŚŹŻ][\\w-]+(?: [A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż][\\w-]*){0,2}",
  "regon": {
