  "street_address": "\\b(?i:(?:Via|Viale|Piazza|Piazzale|Corso|Largo|Vicolo|Strada|Contrada|Località)\\s|(?:V\\.le|P\\.zza|P\\.le|C\\.so|C\\.da|Loc\\.)\\s?)(?:(?:di|del|della|delle|dei|degli|dello)\\s|dell'|d')*(?!(?i:whatsapp|telegram|facebook|instagram|messenger|skype|signal|sms|pec|(?:e-?)?mail|internet|web)\\b)(?:\\d{1,2}°?\\s)?[A-Z][\\w'. -]{0,40}?,?\\s(?:n[.°]?\\s?)?\\d{1,4}(?:\\s?/\\s?[A-Za-z0-9]{1,3}|\\s?bis|[A-Z])?\\b",
