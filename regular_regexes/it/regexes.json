    "validator": "phone",
    "regions": "IT VA"
  },
  "postal_code_city": "\\b\\d{5}\\s(?!EUR|Euro|USD|CHF|GBP|Lire)[A-Z][\\w'-]*(?:\\s(?:(?:di|del|della|delle|dei|degli|dello|in|sul|sulla|e)\\s|dell'|nell'|d')*(?!Tel\\b|Fax\\b)[A-Z][\\w'-]*)*(?:\\s\\([A-Z]{2}\\))?",
