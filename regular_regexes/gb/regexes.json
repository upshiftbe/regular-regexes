{
  "aircraft_registration": "\\bG-[A-Z]{4}\\b",
  "bic": "\\b[A-Z]{4}GB[A-Z0-9]{2}(?:[A-Z0-9]{3})?\\b",
  "company_name": "(?<![\\w&'.-])[A-Z][\\w&'.-]*(?: (?:[A-Z0-9][\\w&'.-]*|&)){0,5} (?i:limited|ltd|plc|llp|cic)\\b\\.?",
  "company_number": "(?i)\\b(?:company\\s(?:reg(?:istration)?\\.?\\s)?(?:number|no\\.?)|registered\\s(?:in\\s(?:England(?:\\s(?:and|&)\\sWales)?|Wales|Scotland|Northern\\sIreland),?\\s)?(?:number|no\\.?)|CRN)\\s?:?\\s?(?:[A-Z]{2}\\d{6}|\\d{6,8})\\b",
  "driving_licence_number": "\\b[A-Z][A-Z9]{4} ?\\d(?:[05][1-9]|[16][0-2])(?:0[1-9]|[12]\\d|3[01])\\d ?[A-Z][A-Z9] ?\\d[A-Z]{2}\\b",
  "iban": {
    "regex": "\\bGB\\d{2} ?[A-Z]{4}(?: ?\\d){14}\\b",
    "validator": "iban"
  },
  "iccid": {
    "regex": "\\b8944\\d{14,16}\\b",
    "validator": "luhn"
  },
  "imsi": "\\b23[45]\\d{12}\\b",
  "license_plate": "\\b(?:[A-HK-PRSV-Y][A-HJ-PR-Y]\\d{2} ?[A-HJ-PR-Z]{3}|[A-HJ-NPR-TV-Y](?:[1-9]\\d\\d|[3-9]\\d|2[1-9]) ?[A-HJ-PR-Y]{3}|[A-HJ-PR-Y]{3} ?[1-9]\\d{1,2}[A-HJ-NPR-TV-Y])\\b",
  "mobile_number": {
    "regex": "(?:(?:\\+|\\b00)44 ?(?:\\(0\\) ?|0)?|\\b0)7(?=[1-57-9]|624)(?:[ -]?\\d){9}\\b",
    "validator": "phone",
    "regions": "GB GG JE IM",
    "kind": "mobile"
  },
  "mrz_passport": {
    "regex": "(?<![A-Z0-9<])[A-Z0-9<]{9}\\dGB[RDNOPS]\\d{6}\\d[MFX<]\\d{6}\\d[A-Z0-9<]{14}[\\d<]\\d(?![A-Z0-9<])",
    "validator": "mrz_td3"
  },
  "msisdn": {
    "regex": "(?<!\\+)\\b447(?:[1-57-9]\\d{8}|624\\d{6})\\b",
    "validator": "phone",
    "regions": "GB GG JE IM",
    "kind": "msisdn"
  },
  "national_insurance_number": "\\b(?!BG|GB|KN|NK|NT|TN|ZZ)[A-CEGHJ-PR-TW-Z][A-CEGHJ-NPR-TW-Z] ?\\d{2} ?\\d{2} ?\\d{2} ?[A-D]\\b",
  "nhs_number": {
    "regex": "(?i)\\bNHS\\s?(?:number|no\\.?)?\\s?:?\\s?\\d{3}[ -]?\\d{3}[ -]?\\d{4}\\b",
    "validator": "gb_nhs_number"
  },
  "passport_number": "(?i)\\bpassport\\s?(?:number|no\\.?)?\\s?:?\\s?\\d{9}\\b",
  "phone_number": {
    "regex": "(?:(?:\\+|\\b00)44 ?(?:\\(0\\) ?|0)?|\\(?\\b0)[1-9]\\d(?:[ )-]{0,2}\\d){8}\\b",
    "validator": "phone",
    "regions": "GB GG JE IM"
  },
  "postal_code": "\\b(?:A[BL]|B[ABDFHLNRSTX]?|C[ABFHMORTVW]|D[ADEGHLNTY]|E[CHNX]?|F[KY]|G[LUY]?|H[ADGPRSUX]|I[GMPV]|JE|K[ATWY]|L[ADELNSU]?|M[EKL]?|N[EGNPRW]?|O[LX]|P[AEHLOR]|R[GHM]|S[AEGKLMNOPRSTWY]?|T[ADFNQRSW]|UB|W[ACDFNRSV]?|YO|ZE)\\d[A-Z\\d]? ?\\d[ABD-HJLNP-UW-Z]{2}\\b",
  "premium_number": {
    "regex": "(?:(?:\\+|\\b00)44 ?(?:\\(0\\) ?|0)?|\\b0)9[018](?:[ -]?\\d){8}\\b",
    "validator": "phone",
    "regions": "GB GG JE IM",
    "kind": "premium"
  },
  "sort_code": "(?i)\\b(?:sort(?:\\s?code)?|s/c)\\W{0,3}\\d{2}[-\\s]?\\d{2}[-\\s]?\\d{2}\\b(?:\\W{1,3}(?:a/c|acc(?:ount)?(?:\\s?(?:no\\.?|number))?)\\W{0,3}\\d{8}\\b)?|\\b\\d{2}-\\d{2}-\\d{2}[\\s,/]{1,3}\\d{8}\\b",
  "street_address": "\\b(?:(?:Flat|Apartment|Apt|Unit) \\d+[A-Z]?,? )?(?!(?:19|20)\\d\\d(?!\\d))\\d{1,4}[A-Za-z]? (?:[A-Z][a-z'-]*\\.? ){1,4}(?:Street|St\\b(?!\\.? [A-Z])|Road|Rd|Lane|Avenue|Ave|Drive|Close|Way|Place|Crescent|Court|Gardens|Grove|Terrace|Square|Mews|Hill|Row|Walk|Parade)\\b",
  "utr": {
    "regex": "(?i)\\b(?:UTR|unique\\staxpayer\\sreference|tax\\sreference)(?:\\s?(?:number|no\\.?))?\\s?:?\\s?\\d{5}\\s?\\d{5}\\b",
    "validator": "gb_utr"
  },
  "vat_number": {
    "regex": "(?:\\b(?:GB|XI) ?|(?i:\\bVAT\\s?(?:reg(?:istration)?\\.?\\s?)?(?:number|no\\.?)\\s?:?\\s?))\\d{3}[ .-]?\\d{4}[ .-]?\\d{2}(?:\\d{3})?\\b|\\bGB ?(?:GD[0-4]|HA[5-9])\\d{2}\\b",
    "validator": "gb_vat_number"
  }
}
