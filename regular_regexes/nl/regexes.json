{
  "aircraft_registration": "\\bPH-(?:[A-Z]{3}|[1-9][A-Z][A-Z\\d]|[1-9]\\d{2,3})\\b",
  "bic": "\\b[A-Z]{4}NL[A-Z0-9]{2}(?:[A-Z0-9]{3})?\\b",
  "bsn": {
    "regex": "(?i:\\b(?:bsn|burgerservicenummer|sofi[- ]?(?:nummer|nr)|persoonsnummer)\\b)[^\\d\\n]{0,20}\\d(?:[ .-]?\\d){8}\\b|(?<!\\d\\.)\\b\\d{4}\\.\\d{2}\\.\\d{3}\\b(?!\\.\\d)",
    "validator": "nl_bsn"
  },
  "company_name": "\\bStichting(?: (?:(?:van|voor|de|der|het|tot) ){0,3}[A-Z0-9][\\w&'-]{0,30}){1,6}|\\b(?:(?:[A-Z]\\.){1,4}|[A-Z][\\w&'-]{0,30})(?: (?:(?:[A-Z]\\.){1,4}|[A-Z0-9][\\w&'-]{0,30}|&|van|de|der|den|het)){0,6} (?:B\\.V\\.|N\\.V\\.|V\\.O\\.F\\.|v\\.o\\.f\\.|C\\.V\\.|U\\.A\\.|BV|NV|VOF)(?![\\w-])",
  "document_number": "\\b[A-NP-Z]{2}[A-NP-Z\\d]{6}\\d\\b",
  "ecli": "\\bECLI:NL:[A-Z]+:\\d{4}:[A-Z0-9.]*[A-Z0-9]",
  "iban": {
    "regex": "\\bNL\\d{2} ?[A-Z]{4}(?: ?\\d{4}){2} ?\\d{2}\\b",
    "validator": "iban"
  },
  "iccid": {
    "regex": "\\b8931\\d{14,16}\\b",
    "validator": "luhn"
  },
  "imsi": "\\b204\\d{12}\\b",
  "kvk_number": "(?i:\\b(?:kvk|k\\.v\\.k|kamer van koophandel|handelsregister|chamber of commerce|coc)\\b)[^\\d\\n]{0,20}\\d{8}\\b",
  "license_plate": "(?<![\\w#-])(?:(?=[\\dA-BD-PR-Z-]{8}(?![\\w-]))(?:(?=[\\d-]*[A-Z])(?=[A-Z-]*\\d)(?:[A-Z]{2}|\\d{2})(?:-(?:[A-Z]{2}|\\d{2})){2}|[A-Z]{1,3}-\\d{2,3}-[A-Z]{1,3}|\\d{1,3}-[A-Z]{2,3}-\\d{1,3})|(?=[\\dBDFGHJ-NPR-TV-Z]{6}(?![\\w-]))(?:[A-Z]{1,3}\\d{2,3}[A-Z]{1,3}|\\d{1,3}[A-Z]{2,3}\\d{1,3}|[A-Z]{4}\\d{2}|\\d{2}[A-Z]{4}))(?![\\w-])",
  "mobile_number": {
    "regex": "(?:(?:\\+|\\b00)31[ -]?(?:\\(0\\)[ -]?)?|(?<!\\d )(?<!\\b[A-Z]{4} )\\b0)6[ -]?[1-58](?:[ -]?\\d){7}\\b(?![.:]\\d)",
    "validator": "phone",
    "regions": "NL",
    "kind": "mobile"
  },
  "mrz_id_card": {
    "regex": "(?<![A-Z0-9<])[IAC][A-Z<]NLD[A-Z0-9<]{25}(?![A-Z0-9<])",
    "validator": "mrz_td1"
  },
  "mrz_passport": {
    "regex": "(?<![A-Z0-9<])[A-Z0-9<]{9}\\dNLD\\d{6}\\d[MFX<]\\d{6}\\d[A-Z0-9<]{14}[\\d<]\\d(?![A-Z0-9<])",
    "validator": "mrz_td3"
  },
  "msisdn": {
    "regex": "\\b316[1-58]\\d{7}\\b",
    "validator": "phone",
    "regions": "NL",
    "kind": "msisdn"
  },
  "phone_number": {
    "regex": "(?:(?:\\+|\\b00)31[ -]?(?:\\(0\\)[ -]?)?|(?<!\\d )(?<!\\b[A-Z]{4} )\\b0)(?:[1-357-9]\\d|4(?=[0356]|1[1-368]|7[58]|8[15-8]|9[23579])\\d|6[ -]?[1-58])(?:[ -]?\\d){7}\\b(?![.:]\\d)",
    "validator": "phone",
    "regions": "NL"
  },
  "postal_code": "\\b[1-9]\\d{3} ?(?!S[ADS]|[KMGT]B)[A-Z]{2}\\b",
  "postnl_tracking_number": "\\b3S(?=[A-Z\\d]{11}\\b|[A-Z\\d]{13}\\b)[A-Z]{1,4}\\d{7,12}\\b",
  "premium_number": {
    "regex": "(?<!\\d )\\b090[069](?:[ -]?\\d){4}(?:(?:[ -]?\\d){3})?\\b",
    "validator": "phone",
    "regions": "NL",
    "kind": "premium"
  },
  "rsin": {
    "regex": "(?i:\\brsin\\b)[^\\d\\n]{0,20}\\d(?:[ .-]?\\d){8}\\b",
    "validator": "nl_bsn"
  },
  "street_address": "\\b[A-Z][\\w'-]{0,40}?(?:straat|str\\.?|laan|weg|gracht|kade|plein|singel|dijk|dreef|steeg|markt|hof|park|plantsoen|wal|haven|baan) [1-9]\\d{0,4}(?:[A-Za-z]|\\s?(?:hs|bis|I{1,3}|IV)|-\\w{1,4})?\\b",
  "tikkie_link": "\\b(?:https?://)?(?:www\\.)?tikkie\\.me/pay/[A-Za-z0-9]+(?:/[A-Za-z0-9]+)?",
  "vat_number": {
    "regex": "\\bNL ?\\d{4}\\.?\\d{2}\\.?\\d{3}[ .]?B[ .]?\\d{2}\\b",
    "validator": "nl_vat_number"
  }
}
